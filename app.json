{
  "buildpacks": [
    { "url": "heroku/php" }
  ],
  "env": {
    "APP_KEY": {
      "generator": "secret"
    },
    "APP_ENV": {
      "value": "production"
    },
    "APP_DEBUG": {
      "value": "false"
    },
    "SESSION_DRIVER": {
      "value": "cookie"
    },
    "CACHE_STORE": {
      "value": "file"
    },
    "QUEUE_CONNECTION": {
      "value": "sync"
    }
  }
}
